        "## 1.1 Carga de los CSV desde GitHub\n",
        "\n",
        "Cada año se lee de su CSV en el repositorio de GitHub (URL *raw*). Esos CSV traen encabezados en español, campos de texto rellenados con espacios y no incluyen `id_Mes`; por eso se quitan los espacios, se renombran las columnas a los nombres de la API de la ARESEP (los que usa el resto del cuaderno) y `id_Mes` se reconstruye a partir del nombre del mes (Setiembre = 9).\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "ypyuVwILFPsW",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "execution": {
          "iopub.execute_input": "2026-10-06T07:54:12.442241Z",
          "iopub.status.busy": "2026-10-06T07:54:12.441671Z",
          "iopub.status.idle": "2026-10-06T07:54:12.727878Z",
          "shell.execute_reply": "2026-10-06T07:54:12.724544Z"
        },
        "id": "ypyuVwILFPsW",
        "outputId": "fe0f90f6-3860-4a6b-b1e7-5350bc06e847"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "2025: GitHub, 880 registros\n",
            "2026: GitHub, 592 registros\n",
            "Años pendientes: ninguno, los datasets se cargaron correctamente\n"
          ]
        }
      ],
      "source": [
        "URLS_DATOS = {\n",
        "    2025: \"https://raw.githubusercontent.com/nico45zh/analisis-electricidad-costarica/refs/heads/main/datos/Datos_Abiertos_ARESEP_Precios_medios_2025.csv\",\n",
        "    2026: \"https://raw.githubusercontent.com/nico45zh/analisis-electricidad-costarica/refs/heads/main/datos/Datos_Abiertos_ARESEP_Precios_medios_2026.csv\"\n",
        "}\n",
        "\n",
        "ANIOS = list(URLS_DATOS)\n",
        "\n",
        "\n",
        "# Encabezados de los CSV de la ARESEP -> nombres de la API (usados en todo el cuaderno)\n",
        "RENOMBRAR_CSV = {\n",
        "    \"Mes\": \"mes\", \"Año\": \"anho\", \"Empresa\": \"empresa\", \"Tarifa\": \"tipoTarifa\",\n",
        "    \"Abonados\": \"abonados\", \"Ventas\": \"ventas\",\n",
        "    \"Ingreso sin CVG\": \"ingresoSinCVG\", \"Ingreso con CVG\": \"ingresoConCVG\",\n",
        "    \"Precio Medio sin CVG\": \"precioMedioSinCVG\", \"Precio Medio con CVG\": \"precioMedioConCVG\",\n",
        "    \"Trimestre\": \"trimestre\", \"Sistema\": \"sistema\", \"Trimestral\": \"trimestral\",\n",
        "}\n",
        "MESES = [\"Enero\", \"Febrero\", \"Marzo\", \"Abril\", \"Mayo\", \"Junio\", \"Julio\", \"Agosto\",\n",
        "         \"Setiembre\", \"Octubre\", \"Noviembre\", \"Diciembre\"]\n",
        "NUM_MES = {m: i + 1 for i, m in enumerate(MESES)}\n",
        "NUM_MES[\"Septiembre\"] = 9\n",
        "\n",
        "COLUMNAS_API = [\n",
        "    \"id_Mes\", \"mes\", \"anho\", \"empresa\", \"tipoTarifa\", \"abonados\", \"ventas\",\n",
        "    \"ingresoSinCVG\", \"ingresoConCVG\", \"precioMedioSinCVG\",\n",
        "    \"precioMedioConCVG\", \"trimestre\", \"sistema\", \"trimestral\"\n",
        "]\n",
        "\n",
        "\n",
        "def limpiar_texto(df):\n",
        "    \"\"\"Quita los espacios de relleno de las columnas de texto.\"\"\"\n",
        "    for col in df.columns:\n",
        "        if df[col].dtype == object or pd.api.types.is_string_dtype(df[col]):\n",
        "            df[col] = df[col].astype(str).str.strip()\n",
        "    return df\n",
        "\n",
        "\n",
        "datos_por_anio = {}\n",
        "\n",
        "for anio in ANIOS:\n",
        "    df = pd.read_csv(URLS_DATOS[anio], encoding=\"utf-8-sig\")\n",
        "    df.columns = df.columns.str.strip()\n",
        "    df = limpiar_texto(df.rename(columns=RENOMBRAR_CSV))\n",
        "    df[\"id_Mes\"] = df[\"mes\"].map(NUM_MES)\n",
        "    assert df[\"id_Mes\"].notna().all(), f\"Meses no reconocidos: {df.loc[df['id_Mes'].isna(), 'mes'].unique()}\"\n",
        "    df[\"id_Mes\"] = df[\"id_Mes\"].astype(int)\n",
        "\n",
        "    datos_por_anio[anio] = df[COLUMNAS_API]\n",
        "\n",
        "    print(f\"{anio}: GitHub, {len(df)} registros\")\n",
        "\n",
        "\n",
        "faltantes = [a for a in ANIOS if a not in datos_por_anio]\n",
        "\n",
        "print(\n",
        "    \"Años pendientes:\",\n",
        "    faltantes if faltantes else \"ninguno, los datasets se cargaron correctamente\"\n",
        ")"
      ]
    },
