        "def comparacion_trimestral(datos, columna_grupo=\"empresa\", orden=None):\n",
        "    subset = datos[datos[\"trimestre\"].isin([\"I Trimestre\", \"II Trimestre\"])]\n",
        "    agregado = (\n",
        "        subset.groupby([columna_grupo, \"anho\", \"trimestre\"])[[\"ingresoConCVG\", \"ventas\"]]\n",
        "        .sum()\n",
        "        .reset_index()\n",
        "    )\n",
        "    agregado[\"precio_ponderado\"] = agregado[\"ingresoConCVG\"] / agregado[\"ventas\"]\n",
        "\n",
        "    pivote = agregado.pivot(index=[columna_grupo, \"trimestre\"], columns=\"anho\",\n",
        "                             values=[\"precio_ponderado\", \"ingresoConCVG\", \"ventas\"])\n",
        "    pivote.columns = [f\"{c}_{a}\" for c, a in pivote.columns]\n",
        "    pivote = pivote.reset_index()\n",
        "\n",
        "    pivote[\"variacion_precio_%\"] = (\n",
        "        (pivote[\"precio_ponderado_2026\"] - pivote[\"precio_ponderado_2025\"])\n",
        "        / pivote[\"precio_ponderado_2025\"] * 100\n",
        "    ).round(2)\n",
        "    pivote[\"variacion_ingreso_%\"] = (\n",
        "        (pivote[\"ingresoConCVG_2026\"] - pivote[\"ingresoConCVG_2025\"])\n",
        "        / pivote[\"ingresoConCVG_2025\"] * 100\n",
        "    ).round(2)\n",
        "    pivote[\"variacion_ventas_%\"] = (\n",
        "        (pivote[\"ventas_2026\"] - pivote[\"ventas_2025\"]) / pivote[\"ventas_2025\"] * 100\n",
        "    ).round(2)\n",
        "\n",
        "    if orden is not None:\n",
        "        pivote[columna_grupo] = pd.Categorical(pivote[columna_grupo], categories=orden, ordered=True)\n",
        "        pivote = pivote.sort_values([columna_grupo, \"trimestre\"])\n",
        "    return pivote.round(2)\n",
        "\n",
        "\n",
        "tabla_trimestral_op = comparacion_trimestral(df_op, orden=ORDEN_OPERADORES)\n",
        "tabla_trimestral_op"
      ]
    },
