        "def precio_ponderado_mensual(datos, columna_grupo=\"empresa\"):\n",
        "    agregado = (\n",
        "        datos.groupby([columna_grupo, \"fecha\"])[[\"ingresoConCVG\", \"ventas\"]]\n",
        "        .sum()\n",
        "        .reset_index()\n",
        "    )\n",
        "    agregado[\"precio_ponderado\"] = agregado[\"ingresoConCVG\"] / agregado[\"ventas\"]\n",
        "    return agregado\n",
        "\n",
        "\n",
        "precio_mensual_op = precio_ponderado_mensual(df_op)\n",
        "precio_mensual_op.head()"
