      "source": [
        "DIR_TABLAS = \"tablas\"\n",
        "os.makedirs(DIR_TABLAS, exist_ok=True)\n",
        "\n",
        "\n",
        "def formato_num(x, decimales=2):\n",
        "    return f\"{x:.{decimales}f}\".replace(\".\", \",\")\n",
        "\n",
        "\n",
        "def formato_signo(x, decimales=2):\n",
        "    return (\"$-$\" if x < 0 else \"$+$\") + formato_num(abs(x), decimales)\n",
        "\n",
        "\n",
        "def formato_pct(x, decimales=2):\n",
        "    return formato_signo(x, decimales) + r\"\\,\\%\"\n",
        "\n",
        "\n",
        "def tabla_latex(nombre_archivo, caption, label, columnas, encabezados, filas, pie=None):\n",
        "    \"\"\"Arma el entorno table (estilo del artículo), lo guarda en tablas/ y lo imprime.\n",
        "\n",
        "    columnas: especificación de columnas, p. ej. \"p{1.2cm} p{0.8cm}\".\n",
        "    encabezados: lista de textos (se ponen en negrita).\n",
        "    filas: lista de listas de textos ya formateados en LaTeX.\n",
        "    pie: texto opcional para una nota al pie de la tabla (ocupa todas las columnas).\n",
        "    \"\"\"\n",
        "    fin = r\" \\\\\"\n",
        "    lineas = [\n",
        "        r\"\\begin{table}[htbp]\",\n",
        "        rf\"\\caption{{{caption}}}\",\n",
        "        rf\"\\label{{{label}}}\",\n",
        "        r\"\\centering\",\n",
        "        r\"\\scriptsize\",\n",
        "        r\"\\renewcommand{\\arraystretch}{1.15}\",\n",
        "        rf\"\\begin{{tabular}}{{@{{}}{columnas}@{{}}}}\",\n",
        "        r\"\\hline\",\n",
        "        \" & \".join(rf\"\\textbf{{{h}}}\" for h in encabezados) + fin,\n",
        "        r\"\\hline\",\n",
        "    ]\n",
        "    lineas += [\" & \".join(fila) + fin for fila in filas]\n",
        "    lineas.append(r\"\\hline\")\n",
        "    if pie:\n",
        "        lineas.append(rf\"\\multicolumn{{{len(encabezados)}}}{{@{{}}l@{{}}}}{{\\footnotesize {pie}}}\" + fin)\n",
        "    lineas += [r\"\\end{tabular}\", r\"\\end{table}\", r\"\\FloatBarrier\"]\n",
        "\n",
        "    texto = \"\\n\".join(lineas) + \"\\n\"\n",
        "    ruta = os.path.join(DIR_TABLAS, nombre_archivo)\n",
        "    with open(ruta, \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(texto)\n",
        "    print(f\"% ===== {ruta} =====\")\n",
        "    print(texto)\n",
        "    return texto"
      ]
    },
