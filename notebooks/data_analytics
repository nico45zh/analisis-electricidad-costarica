        "def serie_mensual_regresion(datos):\n",
        "    \"\"\"Precio ponderado mensual (con y sin CVG) por empresa, con el índice de mes t = 1..20.\"\"\"\n",
        "    agregado = (\n",
        "        datos.groupby([\"grupo\", \"empresa\", \"fecha\"])[[\"ingresoConCVG\", \"ingresoSinCVG\", \"ventas\"]]\n",
        "        .sum()\n",
        "        .reset_index()\n",
        "    )\n",
        "    agregado[\"Con CVG\"] = agregado[\"ingresoConCVG\"] / agregado[\"ventas\"]\n",
        "    agregado[\"Sin CVG\"] = agregado[\"ingresoSinCVG\"] / agregado[\"ventas\"]\n",
        "    agregado[\"t\"] = (agregado[\"fecha\"].dt.year - 2025) * 12 + agregado[\"fecha\"].dt.month\n",
        "    return agregado.sort_values([\"empresa\", \"t\"])\n",
        "\n",
        "\n",
        "serie_reg = serie_mensual_regresion(df_op)\n",
        "VARIANTES = [\"Con CVG\", \"Sin CVG\"]\n",
        "\n",
        "\n",
        "def ajustar_regresiones(serie):\n",
        "    filas = []\n",
        "    ajustes = {}\n",
        "    for empresa in ORDEN_OPERADORES:\n",
        "        sub = serie[serie[\"empresa\"] == empresa]\n",
        "        for variante in VARIANTES:\n",
        "            t, y = sub[\"t\"].to_numpy(float), sub[variante].to_numpy(float)\n",
        "            res = stats.linregress(t, y)\n",
        "            residuos = y - (res.intercept + res.slope * t)\n",
        "            durbin_watson = np.sum(np.diff(residuos) ** 2) / np.sum(residuos ** 2)\n",
        "            margen = stats.t.ppf(0.975, len(t) - 2) * res.stderr\n",
        "            ajustes[(empresa, variante)] = res\n",
        "            filas.append({\n",
        "                \"empresa\": empresa, \"variante\": variante, \"n\": len(t),\n",
        "                \"intercepto\": res.intercept, \"pendiente\": res.slope,\n",
        "                \"ic95_inf\": res.slope - margen, \"ic95_sup\": res.slope + margen,\n",
        "                \"R2\": res.rvalue ** 2, \"valor_p\": res.pvalue, \"durbin_watson\": durbin_watson,\n",
        "            })\n",
        "    return pd.DataFrame(filas), ajustes\n",
        "\n",
        "\n",
        "tabla_regresion, ajustes = ajustar_regresiones(serie_reg)\n",
        "tabla_regresion.round({\"intercepto\": 2, \"pendiente\": 3, \"ic95_inf\": 3, \"ic95_sup\": 3,\n",
        "                       \"R2\": 3, \"valor_p\": 4, \"durbin_watson\": 2})"
      ]
