        "# --- Precios medios extremos: IQR por tipo de tarifa ---\n",
        "def limites_iqr(serie, factor=1.5):\n",
        "    q1, q3 = serie.quantile([0.25, 0.75])\n",
        "    iqr = q3 - q1\n",
        "    return q1 - factor * iqr, q3 + factor * iqr\n",
        "\n",
        "\n",
        "limites = df.groupby(\"tipoTarifa\")[\"precioMedioConCVG\"].apply(limites_iqr)\n",
        "\n",
        "mascara_precio_extremo = pd.Series(False, index=df.index)\n",
        "for tipo, (lim_inf, lim_sup) in limites.items():\n",
        "    en_tipo = df[\"tipoTarifa\"] == tipo\n",
        "    fuera_rango = (df[\"precioMedioConCVG\"] < lim_inf) | (df[\"precioMedioConCVG\"] > lim_sup)\n",
        "    mascara_precio_extremo |= en_tipo & fuera_rango\n",
        "\n",
        "print(f\"Filas con precioMedioConCVG atípico según IQR por tipoTarifa: {mascara_precio_extremo.sum()}\")\n",
        "ejemplos_extremos = (\n",
        "    df.loc[mascara_precio_extremo, [\"fecha\", \"empresa\", \"tipoTarifa\", \"abonados\", \"ventas\", \"precioMedioConCVG\"]]\n",
        "    .sort_values(\"precioMedioConCVG\", ascending=False)\n",
        ")\n",
        "display(ejemplos_extremos.head(10))"
