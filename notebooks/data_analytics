      "source": [
        "# ===== 4.6 Evaluación del pronóstico (may-ago 2026) y escenario a diciembre de 2026 =====\n",
        "# Parte A (evaluación): entrenamiento t = 1..16 (ene-2025 a abr-2026), prueba t = 17..20 (may-2026 a ago-2026);\n",
        "#   se pronostican 4 pasos desde el final del entrenamiento, sin reajustar los modelos.\n",
        "# Parte B (escenario): se reajusta el ARIMAX con los 20 meses y se pronostica t = 21..24 (set-2026 a dic-2026)\n",
        "#   con intervalos de predicción del 95 %, suponiendo que no hay nuevas resoluciones tarifarias.\n",
        "# Usa variables de las celdas anteriores: serie_reg, ORDEN_OPERADORES, VARIANTES, COLOR_OPERADOR,\n",
        "# MARCADOR_OPERADOR, DIR_FIGURAS, MESES_CORTOS, ESTILO_COLUMNA, INK_MUTED, MES_TRANSICION (13),\n",
        "# CORTE_2026 (14) y las importaciones de la celda inicial.\n",
        "\n",
        "FIN_ENTRENAMIENTO = 16          # abr-2026\n",
        "HORIZONTE = 4                   # may..ago-2026 (evaluación) y set..dic-2026 (escenario)\n",
        "MODELOS_PRON = [\"Ingenuo\", \"Regresión con indicador\", \"ARIMAX\"]\n",
        "ORDENES_CANDIDATOS = [(p, 0, q) for p in (0, 1) for q in (0, 1)]\n",
        "TENDENCIAS_CANDIDATAS = [\"c\", \"ct\"]   # constante, o constante + tendencia lineal\n",
        "METODOS_OPTIMIZACION = [\"lbfgs\", \"bfgs\", \"nm\", \"powell\"]\n",
        "LIMITE_RAIZ = 0.99              # |phi| o |theta| >= 0.99: raíz en la frontera (no invertible), se descarta\n",
        "\n",
        "# --- Justificación de no usar un término estacional ---\n",
        "n_meses = serie_reg[\"t\"].nunique()\n",
        "print(f\"Meses disponibles por serie: {n_meses} (entrenamiento: {FIN_ENTRENAMIENTO}, prueba: {HORIZONTE}).\")\n",
        "print(\"Un SARIMA con periodo s = 12 necesita, como mínimo habitual, 2 ciclos completos (24 meses o más)\")\n",
        "print(f\"para estimar la parte estacional; aquí hay {n_meses} meses en total y {FIN_ENTRENAMIENTO} de entrenamiento\")\n",
        "print(f\"({FIN_ENTRENAMIENTO / 12:.2f} ciclos). Una diferencia estacional consumiría 12 de los {FIN_ENTRENAMIENTO} puntos\")\n",
        "print(f\"y dejaría {FIN_ENTRENAMIENTO - 12}. Por eso no se incluye término estacional.\\n\")\n",
        "\n",
        "\n",
        "def exog_arimax(t, tendencia):\n",
        "    \"\"\"Regresores del ARIMAX: constante, [t si tendencia == \"ct\"], escalón 2026 (t >= 14), pulso ene-2026 (t == 13).\n",
        "\n",
        "    La constante y la tendencia se pasan como regresores (regresión con errores ARMA, trend=\"n\"):\n",
        "    en statsmodels, trend=\"ct\" junto con exógenas no reproduce el MCO en el caso (0,0,0)\n",
        "    y da avisos de convergencia; como regresor t sí lo reproduce.\n",
        "    \"\"\"\n",
        "    columnas = [np.ones(len(t))] + ([t] if tendencia == \"ct\" else [])\n",
        "    columnas += [(t >= CORTE_2026).astype(float), (t == MES_TRANSICION).astype(float)]\n",
        "    return np.column_stack(columnas)\n",
        "\n",
        "\n",
        "def ajustar_arimax(y, X, orden):\n",
        "    \"\"\"Ajusta un SARIMAX sin parte estacional con varios optimizadores y conserva el de mayor\n",
        "    log-verosimilitud entre los que convergen (con 16 datos la verosimilitud es plana y un solo\n",
        "    optimizador puede quedarse en un óptimo local).\"\"\"\n",
        "    intentos, mensajes = [], set()\n",
        "    for metodo in METODOS_OPTIMIZACION:\n",
        "        with warnings.catch_warnings(record=True) as avisos:\n",
        "            warnings.simplefilter(\"always\")\n",
        "            ajuste = sm.tsa.SARIMAX(y, exog=X, order=orden, trend=\"n\").fit(\n",
        "                disp=False, method=metodo, maxiter=5000)\n",
        "        convergio = bool(ajuste.mle_retvals.get(\"converged\", False))\n",
        "        mensajes |= {f\"{metodo}: {a.category.__name__}: {str(a.message).splitlines()[0]}\" for a in avisos}\n",
        "        intentos.append((convergio, ajuste.llf, metodo, ajuste))\n",
        "    validos = [i for i in intentos if i[0] and np.isfinite(i[1])]\n",
        "    convergio, _, metodo, ajuste = max(validos or intentos, key=lambda i: i[1])\n",
        "    raices = np.r_[ajuste.arparams, ajuste.maparams]\n",
        "    frontera = bool(np.any(np.abs(raices) >= LIMITE_RAIZ))\n",
        "    return ajuste, convergio, metodo, frontera, sorted(mensajes)\n",
        "\n",
        "\n",
        "def elegir_arimax(t, y, etiqueta, lista_avisos):\n",
        "    \"\"\"Prueba los 8 candidatos (p, q en {0, 1}; tendencia c o ct) y elige el de menor AIC entre los\n",
        "    que convergen y no tienen raíces en la frontera. Devuelve el candidato elegido y la lista completa.\"\"\"\n",
        "    candidatos = []\n",
        "    for orden in ORDENES_CANDIDATOS:\n",
        "        for tendencia in TENDENCIAS_CANDIDATAS:\n",
        "            ajuste, convergio, metodo, frontera, mensajes = ajustar_arimax(y, exog_arimax(t, tendencia), orden)\n",
        "            candidatos.append({\"orden\": orden, \"tendencia\": tendencia, \"AIC\": ajuste.aic,\n",
        "                               \"convergio\": convergio, \"frontera\": frontera, \"metodo\": metodo,\n",
        "                               \"ajuste\": ajuste, \"avisos\": mensajes})\n",
        "            lista_avisos.extend(f\"{etiqueta} {orden} {tendencia} -> {m}\" for m in mensajes)\n",
        "    validos = [c for c in candidatos if c[\"convergio\"] and not c[\"frontera\"]]\n",
        "    return min(validos or candidatos, key=lambda c: c[\"AIC\"]), candidatos\n",
        "\n",
        "\n",
        "def describir_orden(mejor, candidatos):\n",
        "    \"\"\"Fila con el orden elegido, sus coeficientes ARMA y el conteo de candidatos descartados.\"\"\"\n",
        "    ar_ma = dict(zip(mejor[\"ajuste\"].param_names, mejor[\"ajuste\"].params))\n",
        "    return {\"orden\": f\"({mejor['orden'][0]},0,{mejor['orden'][2]})\", \"tendencia\": mejor[\"tendencia\"],\n",
        "            \"AIC\": mejor[\"AIC\"], \"phi\": ar_ma.get(\"ar.L1\", np.nan), \"theta\": ar_ma.get(\"ma.L1\", np.nan),\n",
        "            \"optimizador\": mejor[\"metodo\"], \"convergió\": mejor[\"convergio\"]}\n",
        "\n",
        "\n",
        "def resumir_avisos(lista_avisos, n_candidatos):\n",
        "    # Los EstimationWarning de valores iniciales son benignos (statsmodels arranca en cero);\n",
        "    # los ConvergenceWarning se listan, y en cada candidato se conserva solo un optimizador que sí convergió.\n",
        "    tipos = pd.Series([a.split(\" -> \")[1].split(\": \")[1] for a in lista_avisos], dtype=object)\n",
        "    print(f\"\\nAvisos durante la estimación ({n_candidatos} candidatos x {len(METODOS_OPTIMIZACION)} optimizadores):\")\n",
        "    print(tipos.value_counts().to_string() if len(tipos) else \"ninguno\")\n",
        "    for aviso in lista_avisos:\n",
        "        if \"ConvergenceWarning\" in aviso:\n",
        "            print(\"  \", aviso)\n",
        "\n",
        "\n",
        "def metricas(y_real, y_pron):\n",
        "    error = y_real - y_pron\n",
        "    return {\"MAE\": np.mean(np.abs(error)),\n",
        "            \"RMSE\": np.sqrt(np.mean(error ** 2)),\n",
        "            \"MAPE\": 100 * np.mean(np.abs(error / y_real))}\n",
        "\n",
        "\n",
        "n_candidatos_total = len(ORDEN_OPERADORES) * len(VARIANTES) * len(ORDENES_CANDIDATOS) * len(TENDENCIAS_CANDIDATAS)\n",
        "\n",
        "# ===================== Parte A: evaluación fuera de muestra (may-ago 2026) =====================\n",
        "filas_pron, filas_orden, pronosticos, avisos_arimax = [], [], {}, []\n",
        "for empresa in ORDEN_OPERADORES:\n",
        "    sub_pron = serie_reg[serie_reg[\"empresa\"] == empresa].sort_values(\"t\")\n",
        "    t_tot = sub_pron[\"t\"].to_numpy(float)\n",
        "    entrena = t_tot <= FIN_ENTRENAMIENTO\n",
        "    t_ent, t_pru = t_tot[entrena], t_tot[~entrena]\n",
        "    assert len(t_ent) == FIN_ENTRENAMIENTO and len(t_pru) == HORIZONTE\n",
        "    for variante in VARIANTES:\n",
        "        y_tot = sub_pron[variante].to_numpy(float)\n",
        "        y_ent, y_pru = y_tot[entrena], y_tot[~entrena]\n",
        "\n",
        "        # (1) Ingenuo: último valor de entrenamiento repetido\n",
        "        pron = {\"Ingenuo\": np.repeat(y_ent[-1], HORIZONTE)}\n",
        "\n",
        "        # (2) Regresión con indicador (Sección 4.5): OLS sobre [1, t, D], enero de 2026 excluido\n",
        "        usar = t_ent != MES_TRANSICION\n",
        "        X_ols = np.column_stack([np.ones(usar.sum()), t_ent[usar], (t_ent[usar] >= CORTE_2026).astype(float)])\n",
        "        b_ols = sm.OLS(y_ent[usar], X_ols).fit().params\n",
        "        pron[\"Regresión con indicador\"] = b_ols[0] + b_ols[1] * t_pru + b_ols[2] * (t_pru >= CORTE_2026)\n",
        "\n",
        "        # (3) ARIMAX(p,0,q): orden y tendencia elegidos por AIC en el entrenamiento\n",
        "        mejor, candidatos = elegir_arimax(t_ent, y_ent, f\"{empresa} {variante}\", avisos_arimax)\n",
        "        X_pru = exog_arimax(t_pru, mejor[\"tendencia\"])\n",
        "        pron[\"ARIMAX\"] = np.asarray(mejor[\"ajuste\"].get_forecast(HORIZONTE, exog=X_pru).predicted_mean)\n",
        "        pronosticos[(empresa, variante)] = {\"t\": t_pru, **pron}\n",
        "        filas_orden.append({\"empresa\": empresa, \"variante\": variante, **describir_orden(mejor, candidatos),\n",
        "                            \"igual_a_regresión\": bool(np.allclose(pron[\"ARIMAX\"], pron[\"Regresión con indicador\"])),\n",
        "                            \"descartados_frontera\": sum(c[\"frontera\"] for c in candidatos),\n",
        "                            \"sin_converger\": sum(not c[\"convergio\"] for c in candidatos)})\n",
        "\n",
        "        for modelo in MODELOS_PRON:\n",
        "            filas_pron.append({\"empresa\": empresa, \"variante\": variante, \"modelo\": modelo,\n",
        "                               **metricas(y_pru, pron[modelo])})\n",
        "\n",
        "metricas_pronostico = pd.DataFrame(filas_pron)\n",
        "ordenes_arimax = pd.DataFrame(filas_orden)\n",
        "\n",
        "tabla_pronostico = (metricas_pronostico\n",
        "                    .pivot_table(index=[\"empresa\", \"variante\"], columns=\"modelo\",\n",
        "                                 values=[\"MAE\", \"RMSE\", \"MAPE\"], sort=False)\n",
        "                    .swaplevel(axis=1).reindex(columns=MODELOS_PRON, level=0)\n",
        "                    .reindex(columns=[\"MAE\", \"RMSE\", \"MAPE\"], level=1)\n",
        "                    .reindex([(e, v) for e in ORDEN_OPERADORES for v in VARIANTES]))\n",
        "promedio_pronostico = (metricas_pronostico.groupby(\"modelo\")[[\"MAE\", \"RMSE\", \"MAPE\"]]\n",
        "                       .mean().reindex(MODELOS_PRON))\n",
        "\n",
        "print(\"Métricas en los 4 meses de prueba (MAE y RMSE en ₡/kWh, MAPE en %):\")\n",
        "print(tabla_pronostico.round(2).to_string())\n",
        "print(\"\\nPromedio de las 8 series por modelo:\")\n",
        "print(promedio_pronostico.round(2).to_string())\n",
        "print(\"\\nPromedio por modelo y variante:\")\n",
        "print(metricas_pronostico.groupby([\"variante\", \"modelo\"])[[\"MAE\", \"RMSE\", \"MAPE\"]].mean()\n",
        "      .reindex(MODELOS_PRON, level=1).round(2).to_string())\n",
        "print(\"\\nOrden ARIMAX elegido por AIC (exógenas: escalón t >= 14 y pulso t = 13):\")\n",
        "print(ordenes_arimax.round({\"AIC\": 2, \"phi\": 3, \"theta\": 3}).to_string(index=False))\n",
        "print(\"Nota: con orden (0,0,0) y tendencia 'ct', el ARIMAX es MCO sobre [1, t, D, pulso de t = 13], que da los\")\n",
        "print(\"mismos coeficientes que la regresión con indicador sin enero de 2026 (columna igual_a_regresión).\")\n",
        "resumir_avisos(avisos_arimax, n_candidatos_total)\n",
        "\n",
        "# ===================== Parte B: escenario set-dic 2026 sin nuevas resoluciones tarifarias =====================\n",
        "# Se reajusta con t = 1..20 con el mismo procedimiento de selección; para t = 21..24 se mantiene D = 1\n",
        "# (el nivel de 2026 continúa) y el pulso de enero vale 0. El ingenuo repite el valor de agosto de 2026.\n",
        "t_escenario = np.arange(21, 21 + HORIZONTE, dtype=float)\n",
        "fechas_obs = serie_reg.drop_duplicates(\"t\").set_index(\"t\")[\"fecha\"].sort_index()\n",
        "fechas_esc = pd.date_range(fechas_obs.iloc[-1] + pd.offsets.MonthBegin(1), periods=HORIZONTE, freq=\"MS\")\n",
        "meses_esc = [f\"{MESES_CORTOS[f.month - 1]}-{f:%y}\" for f in fechas_esc]\n",
        "\n",
        "filas_esc, escenario, avisos_escenario = [], {}, []\n",
        "for empresa in ORDEN_OPERADORES:\n",
        "    sub_pron = serie_reg[serie_reg[\"empresa\"] == empresa].sort_values(\"t\")\n",
        "    t_tot = sub_pron[\"t\"].to_numpy(float)\n",
        "    for variante in VARIANTES:\n",
        "        y_tot = sub_pron[variante].to_numpy(float)\n",
        "        mejor, candidatos = elegir_arimax(t_tot, y_tot, f\"{empresa} {variante}\", avisos_escenario)\n",
        "        prediccion = mejor[\"ajuste\"].get_forecast(HORIZONTE, exog=exog_arimax(t_escenario, mejor[\"tendencia\"]))\n",
        "        media = np.asarray(prediccion.predicted_mean)\n",
        "        intervalo = np.asarray(prediccion.conf_int(alpha=0.05))\n",
        "        escenario[(empresa, variante)] = {\"t\": t_escenario, \"media\": media,\n",
        "                                          \"inf\": intervalo[:, 0], \"sup\": intervalo[:, 1]}\n",
        "        filas_esc.append({\"empresa\": empresa, \"variante\": variante, **describir_orden(mejor, candidatos),\n",
        "                          **dict(zip(meses_esc, media)),\n",
        "                          \"IC95_dic_inf\": intervalo[-1, 0], \"IC95_dic_sup\": intervalo[-1, 1],\n",
        "                          \"ancho_IC95_dic\": intervalo[-1, 1] - intervalo[-1, 0],\n",
        "                          \"ingenuo (ago-26)\": y_tot[-1]})\n",
        "\n",
        "tabla_escenario = pd.DataFrame(filas_esc)\n",
        "columnas_esc = ([\"empresa\", \"variante\", \"orden\", \"tendencia\"] + meses_esc\n",
        "                + [\"IC95_dic_inf\", \"IC95_dic_sup\", \"ancho_IC95_dic\", \"ingenuo (ago-26)\"])\n",
        "print(\"\\n\\nEscenario sin nuevas resoluciones tarifarias: pronóstico ARIMAX (₡/kWh), reajustado con t = 1..20\")\n",
        "print(tabla_escenario[columnas_esc].round(2).to_string(index=False))\n",
        "print(\"\\nDetalle del orden elegido con los 20 meses:\")\n",
        "print(tabla_escenario[[\"empresa\", \"variante\", \"orden\", \"tendencia\", \"AIC\", \"phi\", \"theta\", \"optimizador\", \"convergió\"]]\n",
        "      .round({\"AIC\": 2, \"phi\": 3, \"theta\": 3}).to_string(index=False))\n",
        "print(f\"\\nAncho del IC 95 % en dic-26: mediana {tabla_escenario['ancho_IC95_dic'].median():.2f} ₡/kWh \"\n",
        "      f\"(rango {tabla_escenario['ancho_IC95_dic'].min():.2f} a {tabla_escenario['ancho_IC95_dic'].max():.2f}).\")\n",
        "print(\"Los intervalos solo reflejan la variabilidad mensual observada: tratan los coeficientes estimados como\")\n",
        "print(\"conocidos (no suman su error de estimación) y no incluyen cambios tarifarios futuros (por ejemplo, el CVG\")\n",
        "print(\"de 2027), por lo que son una cota inferior de la incertidumbre real.\")\n",
        "resumir_avisos(avisos_escenario, n_candidatos_total)\n",
        "\n",
        "# --- Figura 13: precio con CVG observado (ene-25 a ago-26) y escenario ARIMAX set-dic 2026 con IC 95 % ---\n",
        "t_todos = np.r_[fechas_obs.index.to_numpy(float), t_escenario]\n",
        "fechas_todas = list(fechas_obs) + list(fechas_esc)\n",
        "ticks_pron = t_todos[::3]\n",
        "t_ultimo = fechas_obs.index.max()\n",
        "with plt.rc_context(ESTILO_COLUMNA):\n",
