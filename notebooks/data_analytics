        "def atipico_iqr(grupo, factor=1.5):\n",
        "    q1, q3 = grupo.quantile([0.25, 0.75])\n",
        "    iqr = q3 - q1\n",
        "    return (grupo < q1 - factor * iqr) | (grupo > q3 + factor * iqr)\n",
        "\n",
        "\n",
        "n_atipicos = int(df_q.groupby(\"tipoTarifa\")[\"precioMedioConCVG\"].transform(atipico_iqr).sum())\n",
